test_setup { from src.azure_ai import create_client, chat }
test "deployment endpoint and api key auth" { c := create_client({"endpoint": "https://example.openai.azure.com", "deployment": "gpt-4o", "api_key": "fixture-token", "transport": func(url, options) { assert_equal(contains(url, "/openai/deployments/gpt-4o/chat/completions"), 1); assert_equal(options["_headers"]["api-key"], "fixture-token"); return Ok({"_status": 200, "_body": "{\"choices\":[]}"}) }}); assert_true(chat(c, {"messages": []})["ok"]) }
test "Entra bearer is supported" { c := create_client({"endpoint": "https://example.services.ai.azure.com", "deployment": "d", "access_token": "fixture", "transport": func(url, options) { assert_equal(options["_headers"]["Authorization"], "Bearer fixture"); return Ok({"_status": 200, "_body": "{}"}) }}); assert_true(chat(c, {})["ok"]) }
test "unsafe endpoint is rejected" { c := create_client({"endpoint": "http://evil.example"}); assert_true(c["validation_error"] != "") }
