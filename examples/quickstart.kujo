from azure_ai import create_client, chat
client := create_client({"endpoint": env("AZURE_OPENAI_ENDPOINT"), "deployment": "gpt-4o"})
result := chat(client, {"messages": [{"role": "user", "content": "Say hello."}]})
if result["ok"] {
    print(result["data"])
} else {
    eprint(result["message"])
    exit(1)
}
